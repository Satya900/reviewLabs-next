# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
#
# Without these set, the app runs fine in "mock mode": the practice loop
# works via localStorage, but sign-in silently does nothing. See README.md
# "Auth setup" for how to get real values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used to build the GitHub OAuth callback redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 1). Leave unset to run the app against lib/mock-data.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay Subscriptions (Phase 1 wires the Starter plan checkout).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Create a monthly Plan in the Razorpay dashboard for Starter (₹799, first
# outlet) and paste its plan_id here.
RAZORPAY_PLAN_ID_STARTER=

# Email (request + reminder sends), via Resend.
RESEND_API_KEY=
# Sender address for review-request emails (lib/email.ts). Falls back to
# reviews@reviewlabs.space if unset.
EMAIL_FROM_ADDRESS=

# Cloudflare Turnstile (bot protection on the public rating/feedback forms).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Observability (wired in Phase 1 per the PRD's tech stack table).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Base URL used in QR codes / email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Business Profile OAuth (Phase 2). Create an OAuth client in Google
# Cloud Console with redirect URI {NEXT_PUBLIC_APP_URL}/api/google/callback,
# and request access to the Business Profile APIs (this approval can take a
# while — see PHASES.md Phase 1 "Week 1" note).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI reply-draft router (Phase 2). Router tries these in order and falls
# through on any failure; only one is required to get reply drafts working.
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-32b
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Scheduled review sync (Phase 2). Protects /api/cron/sync-google-reviews.
# On Vercel: add this env var and Vercel automatically sends it as the
# Authorization bearer for the cron job defined in vercel.json. Only fires
# once the app is deployed somewhere with a public URL — cron can't reach
# localhost.
CRON_SECRET=
